{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "LOG_LEVEL",
        "APP_KEY",
        "APP_URL",
        "SESSION_DRIVER",
        "CORS_ORIGIN"
      ],
      "outputs": []
    },
    "generate-routes": {
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
